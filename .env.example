# Connexion Neon (Postgres). Récupérez la "Connection string" dans le dashboard Neon.
# Gardez "?sslmode=require" à la fin.
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Chaîne aléatoire longue utilisée pour signer les sessions de connexion.
# Générez-en une avec: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-long-random-string

# Secret partagé entre le Cron Job Render et l'appli, pour sécuriser /api/cron/reminder.
CRON_SECRET=change-me-another-random-string

# URL publique de l'appli une fois déployée sur Render (utilisée dans le message Teams et le cron).
APP_URL=https://cantine-app.onrender.com

# URL du webhook Teams (Incoming Webhook du canal, ou URL de déclenchement d'un flux Power Automate).
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/xxxxx

# Comptes créés automatiquement au premier démarrage si les tables sont vides.
# Laissez vide pour ne pas créer de compte automatiquement (vous pourrez toujours en recréer via SQL).
ADMIN_BOOTSTRAP_NAME=Admin RH
ADMIN_BOOTSTRAP_CODE=changeme123
PROVIDER_BOOTSTRAP_NAME=Prestataire Cantine
PROVIDER_BOOTSTRAP_CODE=changeme456
